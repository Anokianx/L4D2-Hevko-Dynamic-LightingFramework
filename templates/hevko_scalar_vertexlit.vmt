"VertexLitGeneric"
{
	"$basetexture" "models\weapons\v_models\your_mod\diffuse" //Modify the path here//
	"$selfillum" "1"
	"$selfillummask" "models\weapons\v_models\your_mod\glow_mask" //Modify the path here//
	"$selfillumtint" "[1.20 1.12 1.36]"
	"$hevko_project" "Hevko"
	"$hevko_author" "Anokianx"
	"$hevko_t" "1.0"
	"$hevko_half" "0.5"
	"$hevko_one" "1.0"
	"$hevko_two" "2.0"
	"$hevko_w0" "0.0"
	"$hevko_w1" "0.0"
	"$hevko_w2" "1.0"
	"$hevko_invt" "0.0"
	"$hevko_c_low" "[2.00 0.22 0.34]"
	"$hevko_c_mid" "[1.60 1.24 0.36]"
	"$hevko_c_high" "[1.20 1.12 1.36]"
	"$hevko_v0" "[0 0 0]"
